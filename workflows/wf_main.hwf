<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_main</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Corrida Acciones PIN: Reset H2 → Python STG → 3 extracts Oracle→H2 → R → Oracle RPT_ACCIONES_UBIGEO</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/05 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/27 15:20:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/h2/scripts/reset_and_create.${SCRIPT_EXT}</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>N</insertScript>
      <script/>
      <name>Reset H2 clean</name>
      <description>stop + start H2 mem + DDL (00_reset.sql + 01_schema.sql)</description>
      <type>SHELL</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>176</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/python/run_create_stg.${SCRIPT_EXT}</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>N</insertScript>
      <script/>
      <name>Python create STG</name>
      <description>inputs.yaml → CREATE TABLE STG_ORA_* en H2</description>
      <type>SHELL</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>320</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_acciones.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Load Acciones</name>
      <description>Oracle → H2 STG_ORA_ACCIONES</description>
      <type>PIPELINE</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>480</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_adminuf.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Load AdminUF</name>
      <description>Oracle → H2 STG_ORA_ADMINUF</description>
      <type>PIPELINE</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/pipelines/pl_stage_documentos.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>Load Documentos</name>
      <description>Oracle → H2 STG_ORA_DOCUMENTOS</description>
      <type>PIPELINE</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/r/run_main.${SCRIPT_EXT}</filename>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>N</insertScript>
      <script/>
      <name>Run R</name>
      <description>Rscript: STG_* → acciones_pin → Oracle RPT_ACCIONES_UBIGEO</description>
      <type>SHELL</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>960</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1120</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Load Acciones</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load Acciones</from>
      <to>Load AdminUF</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load AdminUF</from>
      <to>Load Documentos</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load Documentos</from>
      <to>Run R</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run R</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <height>110</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>CORRIDA Acciones PIN.
Diseño STG: wf_create_stg.hwf (deja H2 vivo).
Cadena: Reset → Python STG → Acciones → AdminUF → Documentos → R → Success.
Fuentes: inputs.yaml → STG_ORA_*. Destino: RPT_ACCIONES_UBIGEO (DB_ORA_REPO_*).
SCRIPT_EXT=sh|bat. Conexiones: h2 / oracle_sisud / oracle_repocsep.</note>
      <width>760</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
